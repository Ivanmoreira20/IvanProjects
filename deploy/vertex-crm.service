[Unit]
Description=Vertex CRM (FastAPI)
After=network-online.target
Wants=network-online.target
# Com Restart=always, isto só dispara quando o app esgota as retentativas
# (crash-loop) -- ou seja, exatamente quando o dono precisa saber.
OnFailure=vertex-alert@%n.service

[Service]
Type=exec
User=vertex
Group=vertex
WorkingDirectory=/opt/vertex-crm/backend
Environment=VERTEX_DB=/var/lib/vertex-crm/vertex.db
Environment=VERTEX_HOME=/etc/vertex-crm
Environment=PYTHONUNBUFFERED=1
# --proxy-headers + forwarded-allow-ips: sem isso o app le o esquema como http
# e emite o cookie de sessao SEM a flag Secure, mesmo o site sendo https.
ExecStart=/opt/vertex-crm/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --log-level info
Restart=always
RestartSec=3

# Endurecimento
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/vertex-crm

[Install]
WantedBy=multi-user.target
