# =============================================================================
# Vertex CRM -- exemplo de configuracao
# =============================================================================
#
# COMO USAR
#   1. Copie este arquivo para `.env` (sem o `.example`) na MESMA pasta.
#         PowerShell:  Copy-Item .env.example .env
#   2. Preencha os valores.
#   3. Reinicie o servidor. O `.env` NUNCA vai para o Git (ja esta no .gitignore).
#
# ONDE O ARQUIVO E PROCURADO (o primeiro encontrado vence)
#   1. $VERTEX_HOME/.env   -> ao lado do VertexCRM.exe, quando empacotado
#   2. Dashboard/.env      -> aqui, o caso normal de quem roda o codigo
#   3. ../.env             -> ao lado da pasta Dashboard/
#   4. Dashboard/backend/.env
#
# REGRAS DO ARQUIVO
#   * uma `CHAVE=valor` por linha;
#   * linha vazia e linha comecando com `#` sao ignoradas;
#   * NAO existe comentario no fim da linha -- tudo depois do primeiro `=` e
#     valor (senha pode conter `#`);
#   * aspas ao redor do valor sao opcionais e removidas;
#   * uma variavel de ambiente de verdade sempre vence o que estiver aqui.
#
# O app FUNCIONA SEM ESTE ARQUIVO. Sem Google, o botao "Entrar com Google"
# simplesmente nao aparece. Sem SMTP, o codigo de verificacao e impresso no
# console do servidor em vez de enviado por e-mail -- o cadastro continua
# inteiro e testavel.
# =============================================================================


# -----------------------------------------------------------------------------
# LOGIN COM GOOGLE (opcional)
# -----------------------------------------------------------------------------
# Como obter as credenciais:
#   1. https://console.cloud.google.com/  -> crie (ou escolha) um projeto.
#   2. "APIs e servicos" > "Tela de consentimento OAuth":
#        - Tipo: Externo
#        - Preencha nome do app, e-mail de suporte e e-mail do desenvolvedor
#        - Em "Usuarios de teste", adicione os e-mails que vao poder entrar
#          enquanto o app estiver em modo de teste.
#   3. "APIs e servicos" > "Credenciais" > "Criar credenciais" >
#      "ID do cliente OAuth" > Tipo: "Aplicativo da Web".
#   4. Em "URIs de redirecionamento autorizados", cole EXATAMENTE o valor de
#      GOOGLE_REDIRECT_URI abaixo. Um caractere diferente e o Google recusa.
#   5. Copie o ID e a chave secreta para as duas linhas seguintes.
#
# Os dois campos precisam estar preenchidos para o login com Google ligar.
# Com qualquer um vazio, GET /api/config responde google_enabled: false e
# GET /api/auth/google/start responde 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Precisa bater byte a byte com o cadastrado no console do Google.
# Se voce mudar a porta do servidor, mude aqui e la tambem.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback


# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL (opcional) -- codigo de verificacao do cadastro
# -----------------------------------------------------------------------------
# Para o Gmail, NAO use a senha normal da conta: ela nao funciona em SMTP.
#   1. Ative a verificacao em duas etapas na conta Google.
#   2. Acesse https://myaccount.google.com/apppasswords
#   3. Gere uma "Senha de app" e cole em SMTP_PASS (16 letras; pode colar com
#      ou sem os espacos).
#
# Porta 587 = STARTTLS (padrao, recomendado). Porta 465 = SSL direto; o codigo
# detecta a porta 465 e troca de modo sozinho.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remetente exibido. Deixe vazio para usar o proprio SMTP_USER.
# O Gmail so aceita enviar como o proprio endereco autenticado (ou um alias
# verificado); qualquer outro endereco aqui e reescrito por ele.
SMTP_FROM=Vertex CRM <seu@gmail.com>


# -----------------------------------------------------------------------------
# APLICACAO
# -----------------------------------------------------------------------------
# URL base publica do app. Usada em log e para montar links absolutos.
# Se voce trocar a porta do uvicorn, atualize aqui e no GOOGLE_REDIRECT_URI.
APP_BASE_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# PERFIS DE DEMONSTRACAO (Ana / Bruno / Carla)
# -----------------------------------------------------------------------------
# Vazio = semeia Ana / Bruno / Carla quando o banco esta vazio (comportamento
# de sempre, util na sua maquina para ver o app com dados).
#
# NO SERVIDOR PUBLICADO, USE VERTEX_SEED=0.
#
# O motivo: esses perfis tem senha fixa e publicada no README. Na sua maquina
# isso e a demonstracao; num site aberto na internet seria uma porta destrancada,
# com qualquer visitante entrando como "Ana" so de ler a documentacao.
#
# VERTEX_SEED=1 forca semear. VERTEX_SEED=0 forca nao semear.
VERTEX_SEED=


# -----------------------------------------------------------------------------
# MERCADO PAGO -- cobranca dos planos (Fase 3, secoes 10 a 15)
# -----------------------------------------------------------------------------
# Onde pegar: https://www.mercadopago.com.br/developers/panel
#   Suas integracoes -> (crie uma aplicacao) -> Credenciais
#
# Existem DOIS pares de credenciais na mesma tela: as de TESTE (prefixo TEST-)
# e as de PRODUCAO. As de teste nao movem dinheiro nenhum, e o app avisa isso
# em letras grandes na tela de cobranca. Comece por elas.
#
# ATENCAO: este e o unico segredo do sistema que MOVE DINHEIRO. Um vazamento
# aqui nao expoe dados -- cobra e estorna cartao de cliente. Trate como a senha
# do banco, e nunca mande por chat, e-mail ou mensagem.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Segredo da assinatura do webhook. Fica em:
#   Suas integracoes -> a aplicacao -> Webhooks -> Configurar notificacoes
#   -> (cadastre a URL abaixo) -> "Assinatura secreta"
#
# URL para cadastrar la:  https://SEUDOMINIO/api/billing/webhook
#
# SEM ESTE VALOR A COBRANCA NAO FUNCIONA, e isso e proposital: o webhook recusa
# todo aviso que nao consiga verificar. Sem a verificacao, essa rota seria um
# formulario publico onde qualquer pessoa declara a propria conta como paga --
# o formato do corpo e documentado pelo proprio Mercado Pago.
MP_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# PAINEL DO DONO, CORTESIA E PAYWALL
#
# As tres chaves abaixo decidem PERMISSAO e COBRANCA, e por isso moram aqui, no
# .env do servidor, e nunca no banco: um dump do vertex.db ou uma sessao
# roubada nao podem transformar ninguem em dono nem liberar acesso pago,
# porque a resposta para "quem e' dono?" nao esta la dentro.
# ---------------------------------------------------------------------------

# E-mails (separados por virgula) com acesso ao painel que ve TODAS as contas.
# Deixe vazio se ninguem deve ter esse painel -- quem nao esta na lista recebe
# 404, e nao 403: a existencia do painel nem e revelada.
VERTEX_OWNER_EMAILS=

# E-mails (separados por virgula) com Pro vitalicio de cortesia, sem cobranca.
# Independente da lista acima: ser dono do painel e ter o produto de graca sao
# concessoes separadas. Nao escreve nada em `subscriptions` -- a cortesia e
# resolvida na leitura.
VERTEX_COMP_PRO_EMAILS=

# Paywall: `1` exige assinatura vigente para usar o CRM (o fim do plano
# gratuito). Vazio ou `0` mantem o comportamento antigo.
#
# LIGAR ISTO BLOQUEIA QUEM NAO TEM ASSINATURA. Antes de ligar em producao:
#   1. avise as contas existentes (a pagina de planos prometeu 30 dias);
#   2. de' a elas o prazo de carencia (assinatura ativa com validade);
#   3. so' entao ligue -- e publique a pagina de planos nova junto.
# Desligar e' igualmente barato, e e' o plano de retorno se algo der errado.
#
# O que NUNCA e bloqueado, mesmo com isto ligado: entrar/sair da conta, ver e
# pagar planos, o painel do dono, a proposta publica do cliente, e -- por
# principio e por lei -- exportar e excluir os proprios dados (LGPD).
VERTEX_PAYWALL=
